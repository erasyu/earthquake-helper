<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background"
    android:elevation="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Экстренные службы"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.02"
        android:paddingBottom="4dp"
        android:background="#F5F5F5"
        android:paddingTop="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="5"
        android:baselineAligned="false">

        <Button
            android:id="@+id/btn_mchs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="МЧС\n101"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#F44336"
            android:padding="6dp"
            android:minHeight="0dp"
            android:elevation="3dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btn_police"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Полиция\n102"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#2196F3"
            android:padding="6dp"
            android:minHeight="0dp"
            android:elevation="3dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btn_ambulance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Скорая\n103"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#4CAF50"
            android:padding="6dp"
            android:minHeight="0dp"
            android:elevation="3dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btn_gas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Газ\n104"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#FF9800"
            android:padding="6dp"
            android:minHeight="0dp"
            android:elevation="3dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btn_emergency"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="Единый\n112"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#9C27B0"
            android:padding="6dp"
            android:minHeight="0dp"
            android:elevation="3dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>

